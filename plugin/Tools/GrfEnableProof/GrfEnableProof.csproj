<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the config, starts the REAL game, and asks it what it loaded.
       Everything else about this bug could be argued; this cannot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>grfenableproof</AssemblyName>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\NewGrfEnabler.cs" />
    <Compile Include="..\..\NewGrfScanner.cs" />
    <Compile Include="..\..\OpenTTDPipeServer.cs" />
  </ItemGroup>
</Project>
